# Copy this file to .env and fill in the values you need.
# Never commit .env. Unit tests do not need an API key.

# Required only for a live teacher baseline. Leave blank to skip live calls.
OPENAI_API_KEY=

# Required for a live teacher baseline. Use any model that supports structured outputs.
TEACHER_MODEL=gpt-4o-mini

# Per-attempt timeout, in seconds. The client also retries transient failures.
TEACHER_TIMEOUT_SECONDS=30

# Extra attempts after the first request. Total attempts = 1 + TEACHER_MAX_RETRIES.
# Values above 5 are rejected so a misconfigured run cannot retry without bound.
TEACHER_MAX_RETRIES=2

# Base delay in seconds. Attempt n waits min(8, base * 2^n) before the next try.
TEACHER_RETRY_BACKOFF_SECONDS=0.5

# Sampling temperature. Set to blank to omit the parameter (some reasoning models require that).
TEACHER_TEMPERATURE=0

# Optional cost estimate, in US dollars per 1,000,000 tokens.
# Cost is computed only when BOTH values are set. No provider price is hardcoded.
# Replace the samples below with the rates on your own contract, or leave both blank.
# TEACHER_INPUT_USD_PER_MILLION_TOKENS=0.15
# TEACHER_OUTPUT_USD_PER_MILLION_TOKENS=0.60
TEACHER_INPUT_USD_PER_MILLION_TOKENS=
TEACHER_OUTPUT_USD_PER_MILLION_TOKENS=
