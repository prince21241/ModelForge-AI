# Copy this file to .env and fill in the values you need.
# Never commit .env. Unit tests do not need an API key.

# Required only for a live teacher baseline. Leave blank to skip live calls.
OPENAI_API_KEY=

# Required for a live teacher baseline. Use any model that supports structured outputs.
TEACHER_MODEL=gpt-4o-mini

# Per-attempt timeout, in seconds. The client also retries transient failures.
TEACHER_TIMEOUT_SECONDS=30

# Extra attempts after the first request. Total attempts = 1 + TEACHER_MAX_RETRIES.
# Values above 5 are rejected so a misconfigured run cannot retry without bound.
TEACHER_MAX_RETRIES=2

# Base delay in seconds. Attempt n waits min(8, base * 2^n) before the next try.
TEACHER_RETRY_BACKOFF_SECONDS=0.5

# Sampling temperature. Set to blank to omit the parameter (some reasoning models require that).
TEACHER_TEMPERATURE=0

# Optional cost estimate, in US dollars per 1,000,000 tokens.
# Cost is computed only when BOTH values are set. No provider price is hardcoded.
# Replace the samples below with the rates on your own contract, or leave both blank.
# TEACHER_INPUT_USD_PER_MILLION_TOKENS=0.15
# TEACHER_OUTPUT_USD_PER_MILLION_TOKENS=0.60
TEACHER_INPUT_USD_PER_MILLION_TOKENS=
TEACHER_OUTPUT_USD_PER_MILLION_TOKENS=

# Optional local student cost, in US dollars per 1,000 inferences.
# Leave blank to leave the student cost unset. No GPU price is assumed.
STUDENT_USD_PER_1000_INFERENCES=

# Live teacher comparison is off until you set this to true and restart the API.
# Opening the comparison screen never calls OpenAI. A call also requires teacher_approved=true on that request.
DISTILLOPS_TEACHER_COMPARE_ENABLED=false

# Leave false on this machine. True refuses live teacher calls because the spending counter is process-local.
DISTILLOPS_PUBLIC_DEPLOYMENT=false

# Maximum teacher calls this process may start. The default is 20.
DISTILLOPS_TEACHER_COMPARE_MAX_REQUESTS=20

# Optional dollar cap for teacher calls. Blank uses the request count only.
# A cap also requires both teacher token prices above. The default hold per call is $0.05.
DISTILLOPS_TEACHER_COMPARE_BUDGET_USD=
DISTILLOPS_TEACHER_COMPARE_RESERVE_USD=0.05

# Optional path to tesseract.exe. Leave blank when tesseract is on PATH.
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Upload limits. Blank values use the defaults: 10 MB, 10 PDF pages, 30 second OCR budget, 150 DPI.
DISTILLOPS_MAX_UPLOAD_BYTES=
DISTILLOPS_MAX_PDF_PAGES=
DISTILLOPS_OCR_TIMEOUT_SECONDS=
DISTILLOPS_OCR_DPI=
DISTILLOPS_MAX_IMAGE_PIXELS=
